# Postgres 接続文字列（Supabase の場合は postgres ロール。RLS をバイパスする前提）
DATABASE_URL=postgres://postgres:password@127.0.0.1:5432/mydb

# Supabase プロジェクトURL（JWT の検証に使う。公開情報なので秘密ではない）
SUPABASE_URL=https://<project-ref>.supabase.co

# 管理用API（/reservations, /reservables）を許可する Supabase Auth のユーザーID（カンマ区切り）
ADMIN_USER_IDS=

# CORS で許可するフロントのオリジン（カンマ区切り）
ALLOWED_ORIGINS=http://localhost:5173
